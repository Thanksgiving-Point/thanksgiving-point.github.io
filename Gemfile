source "https://rubygems.org"

# Jekyll 3.9 is the line GitHub Pages builds with, so a local preview matches
# the live site. Run it with:
#
#   bundle exec jekyll serve --livereload
#
gem "jekyll", "~> 3.9.5"

# Required by kramdown 2.x for the GFM input set in _config.yml.
gem "kramdown-parser-gfm", "~> 1.1"
